def compile_vocab(vocab):

    return [

        (weight, re.compile(re.escape(term).replace(r"\ ", r"\s+") + r"\w*", re.IGNORECASE))

        for term, weight in vocab.items()

    ]
 
 
COMPILED_DOMAIN_TARGETS = compile_vocab(DOMAIN_TARGET_VOCABULARY)

COMPILED_DOMAIN_ACTIONS = compile_vocab(DOMAIN_ACTION_VOCABULARY)

COMPILED_LEGAL = [(re.compile(p, re.IGNORECASE), w) for p, w in LEGAL_PATTERNS.items()]

COMPILED_PENALTY = [(re.compile(p, re.IGNORECASE), w) for p, w in PENALTY_PATTERNS.items()]
 
REGISTER_KEYWORD_PATTERN = re.compile(

    r'\b\w*(?:ռեգիստր|ռեեստր|կադաստր|մատյան|շտեմարան)\w*\b', re.IGNORECASE

)
 
