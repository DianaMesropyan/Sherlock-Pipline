# 2. GLOBAL ZERO-COPY CACHE LOADER

# ==============================================================================

GLOBAL_TFIDF = None

GLOBAL_VECTORIZER = None

GLOBAL_DENSE_EMB = None

GLOBAL_MODEL = None

GLOBAL_RECORDS = None

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
 
 
def ensure_fast_cache_loaded(index_dir: str = "index"):

    global GLOBAL_TFIDF, GLOBAL_VECTORIZER, GLOBAL_DENSE_EMB, GLOBAL_MODEL, GLOBAL_RECORDS

    if GLOBAL_TFIDF is not None:

        return  # Already loaded in memory!
 
    t0 = time.time()

    print("⚡ Pre-loading indexes & model into RAM (one-time operation)...")

    idx_path = Path(index_dir) if Path(index_dir).exists() else Path("/kaggle/working/index")
 
    # 1. Load Sparse TF-IDF (~0.2s)

    GLOBAL_TFIDF = load_npz(idx_path / "tfidf_matrix.npz")

    vec_file = idx_path / "tfidf_vectorizer.pkl"

    try:

        GLOBAL_VECTORIZER = joblib.load(vec_file)

    except Exception:

        with open(vec_file, "rb") as f:

            GLOBAL_VECTORIZER = pickle.load(f)
 
    # 2. Memory-Map Dense Embeddings (~0.01s instant)

    emb_file = idx_path / "embeddings.npy" if (idx_path / "embeddings.npy").exists() else idx_path / "dense_matrix.npy"

    if emb_file.exists():

        GLOBAL_DENSE_EMB = np.load(emb_file, mmap_mode="r")
 
    # 3. Load Dense Model (~0.5s)

    if GLOBAL_DENSE_EMB is not None:

        dim = GLOBAL_DENSE_EMB.shape[1]

        model_name = "BAAI/bge-m3" if dim == 1024 else "sentence-transformers/paraphrase-multilingual-mpnet-base-v2"

        os.environ["HF_HOME"] = "/kaggle/working/.cache"

        GLOBAL_MODEL = SentenceTransformer(model_name, device=DEVICE)
 
    # 4. Fast Dataset Pre-loading (Parquet or JSONL into RAM) (~0.3s)

    parquet_path = Path("/kaggle/working/provisions.parquet")

    dataset_file = Path("/kaggle/input/datasets/ineedyoutowork/armenian-legal-provisions/hastat2_provisions.jsonl")

    if not dataset_file.exists():

        dataset_file = Path("/kaggle/input/armenian-legal-provisions/hastat2_provisions.jsonl")
 
    if parquet_path.exists():

        GLOBAL_RECORDS = pd.read_parquet(parquet_path).to_dict(orient="records")

    else:

        # Convert JSONL to Parquet on first run for permanent ultra-fast startup

        df = pd.read_json(dataset_file, lines=True)

        df.to_parquet(parquet_path, engine="pyarrow")

        GLOBAL_RECORDS = df.to_dict(orient="records")
 
    print(f"✅ Cache ready in {time.time() - t0:.2f} seconds! ({len(GLOBAL_RECORDS):,} provisions in RAM)")
 
 
