# 3. SCORING & PARSING UTILITIES

# ==============================================================================

def normalize_text(text: str) -> str:

    if not text:

        return ""

    text = text.lower()

    text = re.sub(r"(\w)-\s*\n\s*(\w)", r"\1\2", text)

    return re.sub(r"\s+", " ", text).strip()
 
 
def parse_query_dynamic(query: str):

    clean_q = re.sub(r"[^\w\s]", "", query.lower()).strip()

    tokens = clean_q.split()

    targets, actions = [], []

    for token in tokens:

        if token in STOP_WORDS_HY or len(token) < 3:

            continue

        is_action = False

        for act in ACTION_VERB_SUFFIXES:

            if act in token:

                actions.append(act)

                is_action = True

                break

        if not is_action:

            stem = token[:6] if len(token) >= 6 else token[:5] if len(token) >= 5 else token

            targets.append(stem)

    return targets, actions
 
 
def split_subchunks(text: str, max_chars: int = 400) -> list[str]:

    if not text:

        return []

    paras = [p.strip() for p in re.split(r'\n\s*\n', text) if p.strip()]

    subchunks = []

    for para in paras:

        if len(para) > max_chars:

            sents = re.split(r'(?<=[․.:;\n])\s+', para)

            curr, curr_len = [], 0

            for s in sents:

                if curr_len + len(s) > max_chars and curr:

                    subchunks.append(" ".join(curr))

                    curr, curr_len = [s], len(s)

                else:

                    curr.append(s)

                    curr_len += len(s)

            if curr:

                subchunks.append(" ".join(curr))

        else:

            subchunks.append(para)

    return subchunks or [text[:max_chars]]
 
 
def score_subchunk_full(subchunk_text: str, q_targets: list[str], q_actions: list[str], base_sim: float):

    norm_text = normalize_text(subchunk_text)

    if not norm_text:

        return None
 
    score = base_sim * 10.0

    evidence = [f"SIM(+{base_sim*10:.2f})"]
 
    # 1. Dynamic Query Target & Action Matches

    matched_q_targets = [t for t in q_targets if t in norm_text]

    matched_q_actions = [a for a in q_actions if a in norm_text]
 
    for t in matched_q_targets:

        score += 5.0

        evidence.append(f"Q_TARGET({t}: +5)")
 
    for a in matched_q_actions:

        score += 4.0

        evidence.append(f"Q_ACTION({a}: +4)")
 
    if matched_q_targets and matched_q_actions:

        score += 6.0

        evidence.append("Q_TARGET_ACTION_COOCCUR(+6)")
 
    # 2. Domain Base Register Vocabulary Boost

    domain_match = None

    for weight, pat in COMPILED_DOMAIN_TARGETS:

        m = pat.search(norm_text)

        if m and (domain_match is None or weight > domain_match["weight"]):

            domain_match = {"matched": m.group(0), "weight": weight, "start": m.start(), "end": m.end()}
 
    if domain_match:

        score += domain_match["weight"]

        evidence.append(f"DOMAIN_BASE({domain_match['matched']}: +{domain_match['weight']})")
 
        # Action Verb Proximity

        best_act_score = -1

        best_act = None

        for weight, pat in COMPILED_DOMAIN_ACTIONS:

            for m in pat.finditer(norm_text):

                dist = (

                    max(0, m.start() - domain_match["end"])

                    if m.start() >= domain_match["end"]

                    else max(0, domain_match["start"] - m.end())

                )

                prox = 3 if dist <= 80 else (2 if dist <= 150 else (1 if dist <= 250 else 0))

                if weight + prox > best_act_score:

                    best_act_score = weight + prox

                    best_act = (m.group(0), weight, prox)
 
        if best_act:

            score += best_act[1] + best_act[2]

            evidence.append(f"DOMAIN_ACTION({best_act[0]}: +{best_act[1]+best_act[2]})")
 
    # 3. Legal Procedural Patterns & Penalties

    legal_val = sum(w for pat, w in COMPILED_LEGAL if pat.search(norm_text))

    if legal_val > 0:

        score += min(legal_val, 8)

        evidence.append(f"LEGAL_PROC(+{min(legal_val, 8)})")
 
    pen_val = sum(w for pat, w in COMPILED_PENALTY if pat.search(norm_text))

    if pen_val < 0:

        score += max(pen_val, -8)

        evidence.append(f"PENALTY({max(pen_val, -8)})")
 
    return {

        "score": round(score, 4),

        "matched_q_targets": matched_q_targets,

        "matched_q_actions": matched_q_actions,

        "domain_register": domain_match["matched"] if domain_match else "N/A",

        "evidence": evidence,

        "subchunk_excerpt": subchunk_text[:160],

    }
 
 
# ==============================================================================

# 4. SUB-SECOND SEARCH EXECUTION ENGINE

# ==============================================================================

def run_fast_search_with_vocab(

    query: str,

    index_dir: str = "index",

    top_k_acts: int = 10,

    top_n_candidates: int = 300,

    output_dir: str = "/kaggle/working/submissions",

):

    ensure_fast_cache_loaded(index_dir)

    start_time = time.time()
 
    q_targets, q_actions = parse_query_dynamic(query)

    norm_q = normalize_text(query)
 
    # Fast Hybrid Vector Search

    q_sparse = GLOBAL_VECTORIZER.transform([norm_q])

    sparse_sims = (GLOBAL_TFIDF @ q_sparse.T).toarray().ravel()
 
    if GLOBAL_DENSE_EMB is not None and GLOBAL_MODEL is not None:

        q_dense = GLOBAL_MODEL.encode([norm_q], normalize_embeddings=True, device=DEVICE)[0]

        dense_sims = np.dot(GLOBAL_DENSE_EMB, q_dense)

        combined_sims = 0.5 * sparse_sims + 0.5 * dense_sims

    else:

        combined_sims = sparse_sims
 
    # Instant Top Candidate Selection via Partitioning

    top_n_idx = np.argpartition(combined_sims, -top_n_candidates)[-top_n_candidates:]

    top_n_idx = top_n_idx[np.argsort(-combined_sims[top_n_idx])]
 
    act_groups = defaultdict(lambda: {

        "act_id": None,

        "act_title": None,

        "total_score": 0.0,

        "relevant_provisions_count": 0,

        "relevant_provisions": [],

        "register_bases": set(),

    })
 
    # Vocabulary & Subchunk Scoring from RAM

    for idx in top_n_idx:

        sim = float(combined_sims[idx])

        if sim <= 0.001 or idx >= len(GLOBAL_RECORDS):

            continue
 
        rec = GLOBAL_RECORDS[idx]

        full_text = rec.get("text_hy") or rec.get("text") or rec.get("full_text") or ""

        subchunks = split_subchunks(full_text)
 
        best_subchunk = None

        for c_idx, sub_text in enumerate(subchunks):

            scored = score_subchunk_full(sub_text, q_targets, q_actions, sim)

            if scored:

                if best_subchunk is None or scored["score"] > best_subchunk["score"]:

                    best_subchunk = scored

                    best_subchunk["chunk_index"] = c_idx + 1
 
        if best_subchunk:

            act_id = str(rec.get("act_id") or rec.get("act_id_hy") or rec.get("id") or "UNKNOWN_ACT")

            act_title = rec.get("act_title_hy") or rec.get("title_hy") or rec.get("title") or "Untitled Act"
 
            grp = act_groups[act_id]

            grp["act_id"] = act_id

            grp["act_title"] = act_title

            grp["total_score"] += best_subchunk["score"]

            grp["relevant_provisions_count"] += 1

            grp["relevant_provisions"].append(best_subchunk)
 
            # Register Bases Extractor

            found_regs = REGISTER_KEYWORD_PATTERN.findall(full_text.lower())

            for reg in found_regs:

                grp["register_bases"].add(reg)
 
    sorted_acts = sorted(act_groups.values(), key=lambda x: x["total_score"], reverse=True)[:top_k_acts]
 
    formatted_results = []

    for act in sorted_acts:

        reg_list = list(act["register_bases"])[:6]

        formatted_results.append({

            "act_id": act["act_id"],

            "act_title": act["act_title"],

            "total_score": round(act["total_score"], 4),

            "relevant_provisions_count": act["relevant_provisions_count"],

            "register_bases": reg_list,

            "provisions": sorted(act["relevant_provisions"], key=lambda p: p["score"], reverse=True),

        })
 
    elapsed = time.time() - start_time

    print(f"⚡ Search completed in {elapsed:.2f} seconds!\n")
 
    for rank, act in enumerate(formatted_results, 1):

        reg_str = ", ".join(act["register_bases"]) if act["register_bases"] else "None"

        print(f"#{rank:02d} | ACT ID: {act['act_id']} | Total Aggregated Score: {act['total_score']:.4f}")

        print(f"    Title               : {act['act_title']}")

        print(f"    Relevant Provisions : {act['relevant_provisions_count']}")

        print(f"    Register Bases      : {reg_str}\n")
 
    out_dir = Path(output_dir)

    out_dir.mkdir(parents=True, exist_ok=True)

    save_path = out_dir / "indexed_top10_act_ids.json"

    with save_path.open("w", encoding="utf-8") as f:

        json.dump(

            {

                "query": query,

                "timestamp": datetime.now(timezone.utc).isoformat(),

                "top_acts": formatted_results,

            },

            f,

            ensure_ascii=False,

            indent=2,

        )
 
    return formatted_results
 
 
# Execute search

results = run_fast_search_with_vocab(query="ինչպես ստանալ վարորդական իրավունք")
 
